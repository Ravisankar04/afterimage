{
  "name": "@afterimage/crypto",
  "version": "0.1.0",
  "description": "Cryptography helpers for AFTERIMAGE: content hashing, canonical JSON, EIP-712, signatures",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\""
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@afterimage/shared": "file:../shared",
    "typescript": "^5.4.5",
    "rimraf": "^5.0.5"
  },
  "license": "MIT"
}
