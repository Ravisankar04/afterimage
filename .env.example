# AFTERIMAGE — environment template
# Copy to .env and fill values. Never commit secrets.

# --- Database ---
DATABASE_URL=postgresql://afterimage:afterimage@localhost:5432/afterimage?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Blockchain (Anvil local by default) ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Anvil account #0 — local only
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONFIRMATIONS_REQUIRED=3

# Contract addresses (set after forge script Deploy)
AFTERIMAGE_REGISTRY_ADDRESS=
EVIDENCE_REGISTRY_ADDRESS=
WITNESS_REGISTRY_ADDRESS=
DISPUTE_REGISTRY_ADDRESS=
OWNERSHIP_REGISTRY_ADDRESS=
EVENT_REGISTRY_ADDRESS=

# Explorer (optional; leave empty to hide links)
BLOCK_EXPLORER_URL=

# --- Storage ---
# local | s3 | ipfs
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs

# --- Uploads ---
MAX_UPLOAD_SIZE=52428800
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif,.mp4,.webm,.mov,.mp3,.wav,.pdf,.txt,.json

# --- AI / RAG ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
SESSION_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# --- Worker ---
WORKER_CONCURRENCY=4
