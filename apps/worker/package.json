{
  "name": "@afterimage/worker",
  "version": "0.1.0",
  "private": true,
  "description": "AFTERIMAGE BullMQ workers — processing, hashing, storage, chain, AI, notifications",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('worker: no unit tests yet'); process.exit(0)\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@afterimage/crypto": "workspace:*",
    "@afterimage/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "license": "MIT"
}
